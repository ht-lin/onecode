# /srv/onecode/.env 模板 —— 复制到服务器后填入真实值，权限 600，永不提交入库。
# 轮换流程见 infra/README.md「Secrets 管理与轮换」。

# API 域名（Caddy 据此自动申请 HTTPS 证书）
SERVER_NAME=api.example.com

# Symfony APP_SECRET：openssl rand -hex 32
APP_SECRET=

# PostgreSQL 凭据：openssl rand -base64 24
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=

# 部署镜像 tag —— CD 每次部署自动改写为 sha-<git sha>，无需手填
API_IMAGE_TAG=latest
