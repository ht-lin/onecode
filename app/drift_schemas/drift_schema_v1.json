  "fixed_sql": [
    {
      "name": "cards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cards\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"code_value\" TEXT NOT NULL, \"code_format\" TEXT NOT NULL, \"card_kind\" TEXT NOT NULL DEFAULT 'loyalty', \"color\" TEXT NOT NULL DEFAULT '#4A6FA5', \"note\" TEXT NULL, \"expires_at\" TEXT NULL, \"sync_status\" TEXT NOT NULL DEFAULT 'local', \"origin\" TEXT NOT NULL DEFAULT 'own', \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "user_card_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_card_states\" (\"card_id\" TEXT NOT NULL REFERENCES cards (id), \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"last_used_at\" TEXT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"card_id\"));"
        }
      ]
    },
    {
      "name": "sync_meta",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_meta\" (\"id\" INTEGER NOT NULL, \"last_cursor\" TEXT NULL, \"device_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
